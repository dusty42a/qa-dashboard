# Redmine
REDMINE_BASE=https://dev.workbooks.com
REDMINE_PROJECT=workbooks
REDMINE_KEY=your-redmine-api-key
# dev.workbooks.com's cert isn't in the local trust store; mirrors -SkipCertificateCheck.
REDMINE_VERIFY_SSL=false

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
RISK_MODEL=claude-haiku-4-5-20251001
RISK_ENABLED=true
# Cost guardrails. Comma-separated allowlist of version names — commits
# attached to other versions are stored but not scored. Leave blank to score
# every version (production setting).
RISK_VERSIONS=
# Hard cap on commits scored per refresh cycle.
RISK_MAX_PER_CYCLE=20

# SVN (fallback diff source when Redmine's diff proxy returns 404)
# SVN_BINARY=/usr/bin/svn
# SVN_REPO_URL=svn+ssh://your-svn-server/

# Behavior
UPSTREAM_TTL_SECONDS=600
DIFF_LINE_CAP=2000

# Storage
DATA_DIR=/data

# Server
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
